
tant que devant_libre:
    si balise_ici:
        ramasser_balise
    sinon:
        avancer 
    si pas devant_libre:
        tourner_gauche
        si pas devant_libre:
            tourner_gauche
            tourner_gauche
    si balise_ici:
        ramasser_balise

repeter 100 fois:
    si balise_ici:
        ramasser_balise
    si gauche_libre:
        tourner_gauche
    si droite_libre:
        tourner_gauche 
        tourner_gauche
        tourner_gauche
    si devant_libre:
        avancer 